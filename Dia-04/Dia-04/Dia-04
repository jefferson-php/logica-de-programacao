algoritmo
var
  n1, n2: inteiro
inicio
  escreva("Digite um Número: ")
  leia(n1)
  escreva("Digite Outro número: ")
  leia(n2)
  se n1 > n2 entao
  escreva("Primeiro número Maior!")
  senao 
  se n2 > n1 entao
  escreva("O Segundo Número é Maior ")
  senao
  escreva("Os dois são iguais")
  fimse
  fimse
fimalgoritmo
