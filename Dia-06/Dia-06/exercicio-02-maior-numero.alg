algoritmo
var
  n1, n2: inteiro
inicio
  escreva("Digite p primeiro número: ")
  leia(n1)
  escreva("Digite o segundo número: ")
  leia(n2)
  se (n1 > n2) entao
    escreva("O primeiro número é maior! ")
  senao 
    se (n2 > n1 ) entao
    escreva("O segundo numero é maior!" )
  senao 
  escreva("Os dois são iguais! ")
    fimse
  fimse

fimalgoritmo
